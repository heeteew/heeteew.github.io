body {
.minimal-layout {
    max-width: 900px;
    margin: 0 auto;
}

.minimal-header {
    text-align: center;
    margin-bottom: 40px;
}

.minimal-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    margin: 0 auto 20px;
    object-fit: cover;
    border: 5px solid white;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.minimal-stats {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin: 25px 0;
}

.stat-item {
    text-align: center;
}

.stat-number {
    font-size: 1.5em;
    font-weight: bold;
    color: #e91e63;
}

.stat-label {
    font-size: 0.9em;
    color: #666;
}